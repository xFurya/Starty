<?xml version="1.0" encoding="utf-8"?>
<!-- Живое уведомление идущего старта, свёрнутый вид (система даёт ему около 48dp): метка «ИДЁТ»
     (или «ИТОГ»), что сейчас происходит («На льду — Петросян»), «5 из 12»; ниже — полоса выступлений
     картинкой (Alerts.strip). Только то, что система разрешает в уведомлениях: LinearLayout,
     FrameLayout, TextView, ImageView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <TextView
            android:id="@+id/alert_live_pill"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/alert_pill_live"
            android:gravity="center_vertical"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ИДЁТ"
            android:textColor="@color/alert_live_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_final_pill"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/alert_pill_soon"
            android:gravity="center_vertical"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="ИТОГ"
            android:textColor="@color/alert_soon_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/alert_live_line"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/alert_live_count"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/alert_live_strip"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />
</LinearLayout>
